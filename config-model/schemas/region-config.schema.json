{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegionPricingConfig",
  "type": "object",
  "required": ["region", "version", "validFrom", "resolution", "buildUp"],
  "properties": {
    "region": { "type": "string" },
    "version": { "type": "string" },
    "validFrom": { "type": "string", "format": "date" },
    "resolution": { "type": "array", "description": "Ladder: stockClass -> originOfData -> supplier/COO/OOD -> costBasis -> fallback chain. MROQ is routing input here." },
    "buildUp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["BASE", "FACTOR", "ADDER", "PER_LINE", "CONSTRAINT"] },
          "basis": { "type": "array", "items": { "type": "string" }, "description": "REQUIRED for FACTOR — enforced in validation" },
          "when": { "type": "string", "description": "conditional inclusion expression" },
          "composite": { "type": "boolean" },
          "allocatable": { "type": "boolean" }
        },
        "if": { "properties": { "type": { "const": "FACTOR" } } },
        "then": { "required": ["basis"] }
      }
    },
    "constraints": { "type": "array" },
    "rounding": { "type": "object" },
    "fx": { "type": "object", "description": "explicit conversion step: rate type, date, position in sequence" }
  }
}
