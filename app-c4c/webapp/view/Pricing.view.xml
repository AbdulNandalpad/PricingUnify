<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:t="sap.ui.table"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  controllerName="com.tss.pricing.c4c.controller.Pricing"
  displayBlock="true"
  height="100%">

  <!-- No shell header: this page runs inside a C4C iframe. -->
  <Page id="pricingPage" showHeader="false" backgroundDesign="List">
    <content>

      <MessageStrip id="meErrorStrip" class="sapUiSmallMargin"
        text="{session>/meError}" type="Error" showIcon="true"
        visible="{= !!${session>/meError} }"/>

      <MessageStrip id="noRoleStrip" class="sapUiSmallMargin"
        text="{i18n>noRoleHint}" type="Warning" showIcon="true"
        visible="{= ${session>/meLoaded} &amp;&amp; !${session>/meError} &amp;&amp; !${session>/roles/PricingViewer} &amp;&amp; !${session>/roles/PricingAdmin} }"/>

      <!-- Context header: object-page style — title row + horizontal facts strip. Read-only
           context (C4C passes it); standalone gets the region select + object search. -->
      <VBox id="contextHeader" class="ctxHeader">
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://sales-quote" size="1.5rem" class="ctxIcon sapUiSmallMarginEnd"/>
            <VBox>
              <Title text="{= ${session>/objectType} === 'OPPORTUNITY' ? ${i18n>titleOpportunity} : ${i18n>titleQuote} }" level="H3" class="ctxTitle"/>
              <HBox alignItems="Center">
                <ObjectStatus text="{session>/objectId}" state="Information" visible="{= !!${session>/objectId} }" class="sapUiSmallMarginEnd"/>
                <ObjectStatus text="{i18n>costOnlyBadge}" state="Warning" visible="{= ${session>/objectType} === 'OPPORTUNITY' }"/>
              </HBox>
            </VBox>
          </HBox>
          <HBox alignItems="Center">
            <Text text="{i18n>signedInAs}: {session>/user}" visible="{= !!${session>/user} }" class="sapUiSmallMarginEnd ctxUser"/>
            <Button id="openAdminBtn" text="{i18n>openAdmin}" type="Transparent" icon="sap-icon://action-settings"
              visible="{session>/roles/PricingAdmin}" press=".onOpenAdmin"/>
          </HBox>
        </HBox>
        <HBox wrap="Wrap" class="ctxFacts" alignItems="Start">
          <VBox class="ctxFact">
            <Label text="{i18n>account}"/>
            <Text text="{= ${vm>/header/account} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact">
            <Label text="{i18n>currency}"/>
            <Text text="{= ${vm>/header/currency} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer} }">
            <Label text="{i18n>custId}"/>
            <Text text="{= ${vm>/customer/customerId} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer} }">
            <Label text="{i18n>custCountry}"/>
            <Text text="{= ${vm>/customer/countryCode} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer} }">
            <Label text="{i18n>custTerritory}"/>
            <Text text="{= ${vm>/customer/salesTerritory} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer} }">
            <Label text="{i18n>custClass}"/>
            <Text text="{= ${vm>/customer/classCode} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer} }">
            <Label text="{i18n>custPriceGroup}"/>
            <Text text="{= ${vm>/customer/priceGroup} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer} }">
            <Label text="{i18n>custOod}"/>
            <Text text="{= ${vm>/customer/originOfData} || '—' }" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact">
            <Label text="{i18n>salesOrg}"/>
            <Text text="{session>/salesOrg}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact">
            <Label text="{i18n>region}"/>
            <Text text="{session>/region}" class="ctxValue" visible="{= !!${session>/objectId} }"/>
            <Select selectedKey="{session>/region}" visible="{= !${session>/objectId} }" change=".onRegionChange">
              <core:Item key="EUROPE" text="EUROPE"/>
              <core:Item key="CHINA" text="CHINA"/>
              <core:Item key="INDIA" text="INDIA"/>
              <core:Item key="AMERICAS" text="AMERICAS"/>
            </Select>
          </VBox>
          <!-- Standalone (3c): no objectId -> search field for a Quote/Opportunity id. -->
          <VBox class="ctxFact" visible="{= !${session>/objectId} }">
            <Label text="{i18n>standaloneSearch}"/>
            <HBox>
              <Input id="objectSearch" width="13rem" placeholder="{i18n>standaloneSearchPlaceholder}" submit=".onLoadObject"/>
              <Button text="{i18n>load}" press=".onLoadObject" class="sapUiTinyMarginBegin"/>
            </HBox>
          </VBox>
        </HBox>
        <MessageStrip text="{vm>/message}" type="{vm>/messageType}" showIcon="true" showCloseButton="true"
          class="sapUiTinyMarginTop" visible="{= !!${vm>/message} }" close=".onCloseMessage"/>
      </VBox>

      <!-- Item table: input columns (manual until the Phase 5 C4C adapter fills them) + result columns. -->
      <Panel class="itemsSection" backgroundDesign="Solid">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{i18n>items} ({vm>/itemCount})" level="H4"/>
            <ObjectStatus text="{vm>/orderTotal}" state="Information" class="sapUiSmallMarginBegin" visible="{= !!${vm>/orderTotal} }"/>
            <ToolbarSpacer/>
            <ToggleButton id="moreColsBtn" text="{i18n>moreColumns}" icon="sap-icon://table-column" type="Transparent" pressed="{vm>/showAdvanced}"/>
            <Button id="importBtn" icon="sap-icon://excel-attachment" text="{i18n>importItems}" press=".onOpenImport" type="Transparent"/>
            <Button id="addRowBtn" icon="sap-icon://add" text="{i18n>addItem}" press=".onOpenAddItem" type="Transparent"/>
            <Button id="removeSelectedBtn" icon="sap-icon://delete" text="{i18n>removeSelected} ({vm>/selectedCount})" press=".onRemoveSelected" type="Transparent"
              visible="{= ${vm>/selectedCount} > 0 }"/>
            <Button id="fetchCostsBtn" text="{i18n>fetchCosts}" type="Emphasized" icon="sap-icon://money-bills"
              press=".onFetchCosts" enabled="{= !${vm>/busy} }"/>
            <Button id="calcPricesBtn" text="{i18n>calcPrices}" type="Emphasized" icon="sap-icon://simulate"
              press=".onCalculatePrices" enabled="{= !${vm>/busy} }"
              visible="{= ${session>/objectType} !== 'OPPORTUNITY' }"/>
            <Button id="writeBackBtn" text="{i18n>writeBack}" icon="sap-icon://journey-arrive"
              press=".onWriteBack" enabled="{= !${vm>/busy} &amp;&amp; ${vm>/hasResults} }"/>
          </OverflowToolbar>
        </headerToolbar>
        <content>
          <t:Table id="itemTable" rows="{vm>/items}" selectionMode="MultiToggle" selectionBehavior="RowSelector" busy="{vm>/busy}" busyIndicatorDelay="0"
            visibleRowCountMode="Auto" minAutoRowCount="5" rowHeight="36" alternateRowColors="true"
            rowSelectionChange=".onSelectionChange" cellClick=".onCellClick" noData="{i18n>noItems}">
            <t:columns>
              <t:Column width="3.5rem">
                <Label text="{i18n>colItem}"/>
                <t:template><Text text="{vm>itemNo}"/></t:template>
              </t:Column>
              <t:Column minWidth="130">
                <Label text="{i18n>colProduct}"/>
                <t:template><Input value="{vm>partNumber}" placeholder="EU-T100"/></t:template>
              </t:Column>
              <t:Column minWidth="140" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colDescription}"/>
                <t:template><Input value="{vm>description}"/></t:template>
              </t:Column>
              <t:Column width="5rem">
                <Label text="{i18n>colQty}"/>
                <t:template><Input value="{vm>quantity}" type="Number" textAlign="End"/></t:template>
              </t:Column>
              <t:Column width="4.5rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colUom}"/>
                <t:template><Input value="{vm>uom}"/></t:template>
              </t:Column>
              <t:Column width="5.5rem" hAlign="Center">
                <Label text="{i18n>colStockType}"/>
                <t:template>
                  <ObjectStatus inverted="true" tooltip="{= ${vm>stockClassHow} || ${i18n>stockTypeNotSetHint} }"
                    text="{= ${vm>stockClassSel} === 'MTS' ? 'MTS' : (${vm>stockClassSel} === 'NonMTS' ? 'Non-MTS' : ${i18n>stockTypeNotSet}) }"
                    state="{= ${vm>stockClassSel} === 'MTS' ? 'Success' : (${vm>stockClassSel} === 'NonMTS' ? 'Warning' : 'None') }"/>
                </t:template>
              </t:Column>
              <t:Column width="7rem">
                <Label text="{i18n>colStockClass}"/>
                <t:template>
                  <Select selectedKey="{vm>stockClassSel}" width="100%" change=".onStockClassChange">
                    <core:Item key="" text="{i18n>auto}"/>
                    <core:Item key="MTS" text="MTS"/>
                    <core:Item key="NonMTS" text="Non-MTS"/>
                  </Select>
                </t:template>
              </t:Column>
              <t:Column minWidth="110">
                <Label text="{i18n>colSupplier}"/>
                <t:template><Input value="{vm>supplier}" placeholder="ACME"/></t:template>
              </t:Column>
              <t:Column minWidth="110">
                <Label text="{i18n>colSupplierExt}"/>
                <t:template><Input value="{vm>supplierExternalId}"/></t:template>
              </t:Column>
              <t:Column minWidth="150" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colSupplierName}"/>
                <t:template><Input value="{vm>supplierName}"/></t:template>
              </t:Column>
              <t:Column width="7rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colCategory}"/>
                <t:template><Input value="{vm>productCategory}" placeholder="SEALS"/></t:template>
              </t:Column>
              <t:Column width="5.5rem" visible="{vm>/showAdvanced}" hAlign="Center">
                <Label text="{i18n>colPriceBreak}"/>
                <t:template><Text text="{= ${vm>priceBreak} ? '✓' : '' }"/></t:template>
              </t:Column>
              <t:Column width="5rem" visible="{vm>/showAdvanced}" hAlign="Center">
                <Label text="{i18n>colAltLine}"/>
                <t:template><Text text="{vm>alternativeToLine}"/></t:template>
              </t:Column>
              <t:Column width="8.5rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colCustPart}"/>
                <t:template><Input value="{vm>customerPartNumber}"/></t:template>
              </t:Column>
              <t:Column width="6rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colDataOrigin}"/>
                <t:template><Input value="{vm>ood}" placeholder="SAP"/></t:template>
              </t:Column>
              <t:Column width="6rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colWarehouse}"/>
                <t:template><Input value="{vm>warehouse}" placeholder="EU01"/></t:template>
              </t:Column>
              <t:Column width="4.5rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colPicks}"/>
                <t:template><Input value="{vm>picks}" textAlign="End"/></t:template>
              </t:Column>
              <t:Column width="6rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colLeadTime}"/>
                <t:template><Input value="{vm>leadTime}"/></t:template>
              </t:Column>
              <t:Column width="5.5rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colAddlCost}"/>
                <t:template><Input value="{vm>additionalCost}" placeholder="0–4"/></t:template>
              </t:Column>
              <t:Column width="8rem">
                <Label text="{i18n>colPricingType}"/>
                <t:template>
                  <Select selectedKey="{vm>pricingType}" width="100%">
                    <core:Item key="COST_PLUS" text="{i18n>costPlus}"/>
                    <core:Item key="PRICE_LIST" text="{i18n>priceList}"/>
                  </Select>
                </t:template>
              </t:Column>
              <t:Column width="6rem" visible="{vm>/showAdvanced}">
                <Label text="{i18n>colSourceErp}"/>
                <t:template><Text text="{vm>sourceErp}"/></t:template>
              </t:Column>
              <t:Column width="6.5rem" hAlign="End">
                <Label text="{i18n>colCost}"/>
                <t:template><Text text="{path: 'vm>cost', formatter: '.formatter.fmt2'}"/></t:template>
              </t:Column>
              <t:Column width="7rem" hAlign="End">
                <Label text="{i18n>colLandedCost}"/>
                <t:template><Text text="{path: 'vm>landedCost', formatter: '.formatter.fmt2'}"/></t:template>
              </t:Column>
              <t:Column width="6.5rem" hAlign="End" visible="{= ${session>/objectType} !== 'OPPORTUNITY' }">
                <Label text="{i18n>colPrice}"/>
                <t:template><Text text="{path: 'vm>price', formatter: '.formatter.fmt2'}"/></t:template>
              </t:Column>
              <t:Column width="7rem" hAlign="End">
                <Label text="{i18n>colLineValue}"/>
                <t:template><Text text="{vm>lineValue}"/></t:template>
              </t:Column>
              <t:Column width="6rem" hAlign="End" visible="{= ${session>/objectType} !== 'OPPORTUNITY' }">
                <Label text="{i18n>colMargin}"/>
                <t:template><Text text="{vm>marginPct}"/></t:template>
              </t:Column>
              <t:Column width="7rem">
                <Label text="{i18n>colStatus}"/>
                <t:template>
                  <ObjectStatus
                    text="{parts: ['vm>status', 'vm>confidence'], formatter: '.formatter.statusText'}"
                    state="{parts: ['vm>status', 'vm>confidence'], formatter: '.formatter.statusState'}"
                    active="{= !!${vm>line} }" press=".onShowTrace"/>
                </t:template>
              </t:Column>
              <t:Column width="5.5rem">
                <Label text=""/>
                <t:template>
                  <HBox>
                    <Button icon="sap-icon://detail-view" type="Transparent" tooltip="{i18n>showTrace}"
                      press=".onShowTrace" visible="{= !!${vm>line} }"/>
                    <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>removeItem}" press=".onRemoveRow"/>
                  </HBox>
                </t:template>
              </t:Column>
            </t:columns>
          </t:Table>
        </content>
      </Panel>
    </content>
  </Page>
</mvc:View>
