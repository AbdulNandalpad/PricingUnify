<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:t="sap.ui.table"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  controllerName="com.tss.pricing.c4c.controller.Pricing"
  displayBlock="true"
  height="100%">

  <!-- No shell header: this page runs inside a C4C iframe. -->
  <Page id="pricingPage" showHeader="false" backgroundDesign="List">
    <content>

      <MessageStrip id="meErrorStrip" class="sapUiSmallMargin"
        text="{session>/meError}" type="Error" showIcon="true"
        visible="{= !!${session>/meError} }"/>

      <MessageStrip id="noRoleStrip" class="sapUiSmallMargin"
        text="{i18n>noRoleHint}" type="Warning" showIcon="true"
        visible="{= ${session>/meLoaded} &amp;&amp; !${session>/meError} &amp;&amp; !${session>/roles/PricingViewer} &amp;&amp; !${session>/roles/PricingAdmin} }"/>

      <MessageStrip id="paramStrip" class="sapUiSmallMargin" text="{session>/paramError}" type="Warning" showIcon="true"
        visible="{= !!${session>/paramError} }"/>

      <MessageStrip id="sessionStrip" class="sapUiSmallMargin" text="{i18n>sessionExpired}" type="Error" showIcon="true"
        visible="{= !!${session>/sessionExpired} }">
        <link><Link text="{i18n>reloadPage}" press=".onReloadPage"/></link>
      </MessageStrip>

      <!-- Context header: object-page style — title row + horizontal facts strip. Read-only
           context (C4C passes it); standalone gets the region select + object search. -->
      <VBox id="contextHeader" class="ctxHeader">
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <HBox alignItems="Center">
            <Image src="img/trelleborg-logo.svg" alt="Trelleborg" height="3.25rem" class="ctxLogo"/>
            <VBox class="ctxTitleBlock">
              <Title text="{i18n>titleApp}" level="H3" class="ctxTitle"/>
              <HBox alignItems="Center" wrap="Wrap">
                <Text text="{= ${session>/objectId} ? ( ${session>/objectType} === 'OPPORTUNITY' ? ${i18n>objTypeOpportunity} : ${i18n>objTypeQuote} ) + ' ' + ${session>/objectId} : ${i18n>subtitleBlank} }" class="ctxSubtitle sapUiTinyMarginEnd"/>
                <ObjectStatus text="{i18n>costOnlyBadge}" state="Warning" visible="{= ${session>/objectType} === 'OPPORTUNITY' &amp;&amp; !!${session>/objectId} }" class="sapUiTinyMarginEnd"/>
                <ObjectStatus text="{session>/environment}" state="{= ${session>/environment} === 'PROD' ? 'Error' : 'Warning' }" visible="{= !!${session>/environment} }" tooltip="{i18n>environmentTip}"/>
              </HBox>
            </VBox>
          </HBox>
          <HBox alignItems="Center">
            <Text text="{i18n>signedInAs}: {session>/user}" visible="{= !!${session>/user} }" class="sapUiSmallMarginEnd ctxUser"/>
            <Button id="reloadObjectBtn" text="{i18n>reloadObject}" type="Transparent" icon="sap-icon://refresh"
              visible="{= !!${session>/objectId} }" enabled="{= !${vm>/busy} }" press=".onReloadObject" class="sapUiTinyMarginEnd"/>
            <Button id="openAdminBtn" text="{i18n>openAdmin}" type="Transparent" icon="sap-icon://action-settings"
              visible="{session>/roles/PricingAdmin}" press=".onOpenAdmin"/>
          </HBox>
        </HBox>
        <HBox wrap="Wrap" class="ctxFacts" alignItems="Start">
          <!-- Region once: the pricing region is the one setting that decides the rules, so it
               leads the strip (a select standalone, plain text when C4C passes the context).
               The other facts appear only when they carry a value. Sales org is not shown. -->
          <VBox class="ctxFact">
            <Label text="{i18n>region}"/>
            <Text text="{session>/region}" class="ctxValue" visible="{session>/hostContext}"/>
            <Select selectedKey="{session>/region}" visible="{= !${session>/hostContext} }" change=".onRegionChange">
              <core:Item key="EUROPE" text="EUROPE"/>
              <core:Item key="CHINA" text="CHINA"/>
              <core:Item key="INDIA" text="INDIA"/>
              <core:Item key="AMERICAS" text="AMERICAS"/>
            </Select>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/header/account} }">
            <Label text="{i18n>account}"/>
            <Text text="{vm>/header/account}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/header/currency} }">
            <Label text="{i18n>currency}"/>
            <Text text="{vm>/header/currency}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer/customerId} }">
            <Label text="{i18n>custId}"/>
            <Text text="{vm>/customer/customerId}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer/countryCode} }">
            <Label text="{i18n>custCountry}"/>
            <Text text="{vm>/customer/countryCode}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer/salesTerritory} }">
            <Label text="{i18n>custTerritory}"/>
            <Text text="{vm>/customer/salesTerritory}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer/classCode} }">
            <Label text="{i18n>custClass}"/>
            <Text text="{vm>/customer/classCode}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer/priceGroup} }">
            <Label text="{i18n>custPriceGroup}"/>
            <Text text="{vm>/customer/priceGroup}" class="ctxValue"/>
          </VBox>
          <VBox class="ctxFact" visible="{= !!${vm>/customer/originOfData} }">
            <Label text="{i18n>custOod}"/>
            <Text text="{vm>/customer/originOfData}" class="ctxValue"/>
          </VBox>
          <!-- Standalone (3c): no objectId -> search field for a Quote/Opportunity id. -->
          <VBox class="ctxFact" visible="{= !${session>/hostContext} }">
            <Label text="{i18n>standaloneSearch}"/>
            <HBox>
              <Input id="objectSearch" width="13rem" placeholder="{i18n>standaloneSearchPlaceholder}" submit=".onLoadObject"/>
              <Button text="{i18n>load}" press=".onLoadObject" class="sapUiTinyMarginBegin" enabled="{= !${vm>/busy} }"/>
            </HBox>
          </VBox>
        </HBox>
        <MessageStrip text="{vm>/message}" type="{vm>/messageType}" showIcon="true" showCloseButton="true"
          class="sapUiTinyMarginTop" visible="{= !!${vm>/message} }" close=".onCloseMessage"/>
      </VBox>

      <!-- Item table: input columns (manual until the Phase 5 C4C adapter fills them) + result columns. -->
      <Panel class="itemsSection" backgroundDesign="Solid" width="auto">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{= ${i18n>items} + ' (' + ( ${vm>/search} ? ${vm>/shownCount} + ' / ' + ${vm>/itemCount} : ${vm>/itemCount} ) + ')' }" level="H4"/>
            <SearchField width="17rem" placeholder="{i18n>searchLinesPlaceholder}" liveChange=".onSearchItems" search=".onSearchItems" class="sapUiSmallMarginBegin"/>
            <ObjectStatus text="{vm>/orderTotal}" state="Information" class="sapUiSmallMarginBegin" visible="{= !!${vm>/orderTotal} }"/>
            <ToolbarSpacer/>
            <Button id="importBtn" icon="sap-icon://excel-attachment" text="{i18n>importItems}" press=".onOpenImport" type="Transparent" enabled="{= !${vm>/busy} }">
              <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
            </Button>
            <Button id="addRowBtn" icon="sap-icon://add" text="{i18n>addItem}" press=".onOpenAddItem" type="Transparent" enabled="{= !${vm>/busy} }">
              <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
            </Button>
            <Button id="removeSelectedBtn" icon="sap-icon://delete" text="{i18n>removeSelected} ({vm>/selectedCount})" press=".onRemoveSelected" type="Transparent"
              visible="{= ${vm>/selectedCount} > 0 }" enabled="{= !${vm>/busy} }">
              <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
            </Button>
            <Button id="calculateBtn" type="Emphasized" icon="sap-icon://simulate"
              text="{= ${session>/objectType} === 'OPPORTUNITY' ? ${i18n>calcCost} : ${i18n>calcCostPrice} }"
              tooltip="{= ${session>/objectType} === 'OPPORTUNITY' ? ${i18n>calcCostTip} : ${i18n>calcCostPriceTip} }"
              press=".onCalculate" enabled="{= !${vm>/busy} }">
              <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
            </Button>
            <Button id="writeBackBtn" text="{i18n>writeBack}" icon="sap-icon://journey-arrive"
              press=".onWriteBack" enabled="{= !${vm>/busy} &amp;&amp; ${vm>/writableCount} > 0 }"
              tooltip="{= ${vm>/writableCount} > 0 ? '' : ${i18n>writeBackDisabledTip} }">
              <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
            </Button>
          </OverflowToolbar>
        </headerToolbar>
        <content>
          <t:Table id="itemTable" rows="{vm>/items}" selectionMode="MultiToggle" selectionBehavior="RowSelector" busy="{vm>/busy}" busyIndicatorDelay="0"
            fixedColumnCount="2" visibleRowCountMode="Fixed" visibleRowCount="{= Math.min(Math.max(${vm>/itemCount}, 5), 14) }" rowHeight="44" columnHeaderHeight="40" alternateRowColors="true"
            rowSelectionChange=".onSelectionChange" rowsUpdated=".onRowsUpdated" noData="{= ${vm>/search} ? ${i18n>noMatchingLines} : ${i18n>noItems} }">
            <t:rowSettingsTemplate>
              <t:RowSettings highlight="{= ${vm>itemType} === 'ZKIT' ? 'Information' : 'None' }"/>
            </t:rowSettingsTemplate>
            <t:columns>
              <t:Column width="4.8rem">
                <Label text="{i18n>colDetails}"/>
                <t:template>
                  <HBox>
                    <Button icon="sap-icon://hint" tooltip="{= (${vm>itemType} !== 'ZKIT' &amp;&amp; (!${vm>supplier} || !${vm>ood} || !${vm>warehouse} || !${vm>stockClassSel})) ? ${i18n>detailsMissingTip} : ${i18n>detailsTip} }"
                      type="{= (${vm>itemType} !== 'ZKIT' &amp;&amp; (!${vm>supplier} || !${vm>ood} || !${vm>warehouse} || !${vm>stockClassSel})) ? 'Attention' : 'Transparent' }"
                      press=".onOpenLineDetails"/>
                    <Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>rowMenuTip}" press=".onOpenRowMenu" enabled="{= !${vm>/busy} }"/>
                  </HBox>
                </t:template>
              </t:Column>
              <t:Column width="3.2rem">
                <Label text="{i18n>colItem}"/>
                <!-- A kit's components sit under their header: 10 -> 11, 12, 13 -> next item 20 (SAP sub-item numbering). -->
                <t:template><Text text="{= ${vm>parentItemNo} ? '↳ ' + ${vm>itemNo} : ${vm>itemNo} }" tooltip="{= ${vm>itemType} === 'ZKIT' ? ${i18n>kitHeaderTip} : (${vm>parentItemNo} ? ${i18n>kitComponentTip} : '') }"/></t:template>
              </t:Column>
              <t:Column hAlign="Center" width="3rem">
                <Label text="{i18n>colAltShort}" tooltip="{i18n>colAltLine}"/>
                <t:template><Input value="{vm>alternativeToLine}" type="Number" textAlign="Center" change=".onAltEdited" editable="{= !${vm>parentItemNo} }"
                  valueState="{= ${vm>altInvalid} ? 'Error' : 'None' }" valueStateText="{i18n>altInvalidText}" tooltip="{i18n>colAltLine}"/></t:template>
              </t:Column>
              <t:Column hAlign="Center" width="3.2rem">
                <Label text="{i18n>colBrkShort}" tooltip="{i18n>colPriceBreak}"/>
                <t:template><CheckBox selected="{vm>priceBreak}" select=".onRowEdited" enabled="{= !${vm>parentItemNo} }" tooltip="{i18n>colPriceBreak}"/></t:template>
              </t:Column>
              <t:Column width="6.2rem">
                <Label text="{i18n>colItemType}" tooltip="{i18n>colItemTypeTip}"/>
                <t:template>
                  <Select selectedKey="{vm>itemType}" width="100%" tooltip="{i18n>colItemTypeTip}" showSecondaryValues="true" items="{path: 'vm>/itemTypes', templateShareable: false}" change=".onItemTypeChange" enabled="{= !${vm>parentItemNo} }">
                    <core:ListItem key="{vm>key}" text="{vm>key}" additionalText="{vm>label}"/>
                  </Select>
                </t:template>
              </t:Column>
              <t:Column minWidth="144">
                <Label text="{i18n>colProduct}"/>
                <t:template>
                  <Input value="{vm>partNumber}" change=".onRowEdited" tooltip="{vm>description}"/>
                </t:template>
              </t:Column>
              <t:Column width="8rem" visible="{= ${vm>/xwide} }">
                <Label text="{i18n>colCustPart}"/>
                <t:template><Input value="{vm>customerPartNumber}"/></t:template>
              </t:Column>
              <t:Column width="8rem" visible="{= ${vm>/xwide} }">
                <Label text="{i18n>colCustomItemId}"/>
                <t:template><Input value="{vm>customItemId}"/></t:template>
              </t:Column>
              <t:Column minWidth="150" visible="{= ${vm>/wide} }">
                <Label text="{i18n>colDescription}"/>
                <t:template><Input value="{vm>description}"/></t:template>
              </t:Column>
              <t:Column hAlign="End" width="4.2rem">
                <Label text="{i18n>colQty}"/>
                <t:template><Input value="{vm>quantity}" type="Number" textAlign="End" change=".onQtyChange" editable="{= !${vm>parentItemNo} }" tooltip="{= ${vm>parentItemNo} ? ${i18n>kitQtyFollowsTip} : '' }"/></t:template>
              </t:Column>
              <t:Column visible="{= !${vm>/narrow} }" width="3.4rem">
                <Label text="{i18n>colUom}"/>
                <t:template><Input value="{vm>uom}"/></t:template>
              </t:Column>
              <t:Column visible="{= !${vm>/narrow} }" hAlign="End" width="4.2rem">
                <Label text="{i18n>colPerShort}" tooltip="{i18n>colPriceUnitTip}"/>
                <t:template><Input value="{vm>priceUnit}" type="Number" textAlign="End" change=".onRowEdited" tooltip="{i18n>colPriceUnitTip}"/></t:template>
              </t:Column>
              <t:Column width="8rem">
                <Label text="{i18n>colStockType}"/>
                <t:template>
                  <Select selectedKey="{vm>stockClassSel}" width="100%" change=".onStockClassChange" enabled="{= ${vm>itemType} !== 'ZKIT' }"
                    tooltip="{= ${vm>stockClassHow} || ${i18n>stockTypeNotSetHint} }"
                    valueState="{= ${vm>stockClassSel} === 'MTS' ? 'Success' : (${vm>stockClassSel} === 'NonMTS' ? 'Warning' : 'None') }">
                    <core:Item key="" text="{i18n>stockTypeNotSet}"/>
                    <core:Item key="MTS" text="MTS"/>
                    <core:Item key="NonMTS" text="Non-MTS"/>
                  </Select>
                </t:template>
              </t:Column>
              <t:Column width="4.4rem" hAlign="End" visible="{= ${vm>/xwide} }">
                <Label text="{i18n>colPicks}"/>
                <t:template><Input value="{vm>picks}" type="Number" textAlign="End"/></t:template>
              </t:Column>
              <t:Column width="11rem" visible="{= ${vm>/xwide} }">
                <Label text="{i18n>colAddlCost}"/>
                <t:template><Select selectedKey="{vm>additionalCost}" width="100%" change=".onRowEdited" tooltip="{i18n>colAddlCostTip}">
                    <core:Item key="0" text="{i18n>addlCost0}"/>
                    <core:Item key="1" text="{i18n>addlCost1}"/>
                    <core:Item key="3" text="{i18n>addlCost3}"/>
                    <core:Item key="4" text="{i18n>addlCost4}"/>
                    <core:Item key="5" text="{i18n>addlCost5}" enabled="false"/>
                  </Select></t:template>
              </t:Column>
              <t:Column hAlign="End" width="5.6rem" visible="{= ${session>/objectType} !== 'OPPORTUNITY' }">
                <Label text="{i18n>colLineValue}"/>
                <t:template><Text text="{vm>lineValue}"/></t:template>
              </t:Column>
              <t:Column hAlign="End" width="6rem">
                <Label text="{i18n>colCost}"/>
                <t:template><Input value="{vm>cost}" type="Number" textAlign="End" change=".onCostEdit" valueState="{= ${vm>costManual} ? 'Information' : 'None' }" tooltip="{= ${vm>itemType} === 'ZKIT' ? ${i18n>kitRollUpTip} : ${i18n>costEditTip} }" editable="{= ${vm>itemType} !== 'ZKIT' &amp;&amp; !${vm>parentItemNo} }"/></t:template>
              </t:Column>
              <t:Column hAlign="End" width="5.8rem">
                <Label text="{i18n>colLandedCost}"/>
                <t:template><Text text="{path: 'vm>landedCost', formatter: '.formatter.fmt2'}"/></t:template>
              </t:Column>
              <t:Column hAlign="End" width="6rem" visible="{= ${session>/objectType} !== 'OPPORTUNITY' }">
                <Label text="{i18n>colPrice}"/>
                <t:template><Input value="{vm>price}" type="Number" textAlign="End" change=".onPriceEdit" valueState="{= ${vm>priceBy} === 'PRICE' ? 'Information' : 'None' }" tooltip="{= ${vm>itemType} === 'ZKIT' ? ${i18n>kitRollUpTip} : ${i18n>priceEditTip} }" editable="{= ${vm>itemType} !== 'ZKIT' &amp;&amp; !${vm>parentItemNo} }"/></t:template>
              </t:Column>
              <t:Column hAlign="End" width="5.6rem" visible="{= ${session>/objectType} !== 'OPPORTUNITY' }">
                <Label text="{i18n>colMargin}"/>
                <t:template><Input value="{vm>marginPct}" type="Number" textAlign="End" change=".onMarginEdit" valueState="{= ${vm>priceBy} === 'MARGIN' ? 'Information' : 'None' }" tooltip="{= ${vm>marginNote} || (${vm>itemType} === 'ZKIT' ? ${i18n>kitMarginTip} : ${i18n>marginEditTip}) }" editable="{= !${vm>parentItemNo} }"/></t:template>
              </t:Column>
              <t:Column width="5.6rem" visible="{= ${vm>/wide} }">
                <Label text="{i18n>colDataOrigin}"/>
                <t:template><Input value="{vm>ood}" change=".onRowEdited"/></t:template>
              </t:Column>
              <t:Column width="6.4rem" visible="{= ${vm>/wide} }">
                <Label text="{i18n>colWarehouse}"/>
                <t:template><Input value="{vm>warehouse}" change=".onRowEdited"/></t:template>
              </t:Column>
              <t:Column width="7rem" visible="{= ${vm>/wide} }">
                <Label text="{i18n>colSupplier}"/>
                <t:template><Input value="{vm>supplier}" change=".onRowEdited" editable="{= ${vm>itemType} !== 'ZKIT' }"/></t:template>
              </t:Column>
              <t:Column width="9rem" visible="{= ${vm>/xwide} }">
                <Label text="{i18n>colSupplierName}"/>
                <t:template><Input value="{vm>supplierName}"/></t:template>
              </t:Column>
              <t:Column width="4.8rem">
                <Label text="{i18n>colStatus}"/>
                <t:template>
                  <HBox>
                    <ObjectStatus visible="{= !${vm>stale} }"
                      text="{parts: ['vm>status', 'vm>confidence'], formatter: '.formatter.statusText'}"
                      state="{parts: ['vm>status', 'vm>confidence'], formatter: '.formatter.statusState'}"
                      active="{= !!${vm>line} }" press=".onShowTrace"/>
                    <ObjectStatus visible="{vm>stale}" text="{i18n>statusOutdated}" state="Warning" icon="sap-icon://refresh" tooltip="{i18n>statusOutdatedTip}"/>
                  </HBox>
                </t:template>
              </t:Column>
            </t:columns>
          </t:Table>
        </content>
      </Panel>
    </content>
  </Page>
</mvc:View>
