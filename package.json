{
  "name": "tss-pricing-engine",
  "version": "0.1.0",
  "private": true,
  "description": "TSS Pricing Engine — AI pricing workspace. Landed cost from ERP facts + regional config, explainable, CRM-agnostic.",
  "workspaces": ["engine-core", "config-model", "api6-client", "srv", "app", "mcp-server"],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:golden": "node tests/run-golden.js",
    "start:srv": "node srv/server.js"
  },
  "engines": { "node": ">=20" },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": { "roles": ["PricingViewer"] },
          "bob": { "roles": ["PricingAdmin", "PricingViewer"] }
        },
        "[production]": { "kind": "xsuaa" }
      }
    },
    "server": {
      "cors": true,
      "[production]": { "cors": false }
    }
  }
}
